rules_version = '2';
// Pulseform: paste this into Firebase console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{db}/documents {

    // Cloud saves: each player can only read and write their own save
    // A real account (email or Google). Classroom students can join with a guest sign-in instead (no email), and guests
    // can only use the classroom collections below: every other rule uses signedIn(), which turns guests away.
    function signedIn() {
      return request.auth != null
        && request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'anonymous';
    }
    // anyone with a sign-in, guests included (classroom students)
    function authed() {
      return request.auth != null;
    }

    // An admin: an account that entered the admin code (stored at admins/{uid}, checked below), or one with the
    // Firebase Auth custom claim {admin: true}. Admins can send gifts, run the live event and read reports.
    function isAdmin() {
      return signedIn() && (request.auth.token.admin == true
        || exists(/databases/$(db)/documents/admins/$(request.auth.uid)));
    }

    // Becoming an admin: the code must match its SHA-256 fingerprint (the code itself is never in the game).
    // Only you can see your own admin record; it can't be changed, only removed (when you delete your account).
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['k', 't'])
        && request.resource.data.k is string && request.resource.data.k.size() <= 64
        && request.resource.data.t is int
        && hashing.sha256('pulseform/admin/v1:' + request.resource.data.k).toHexString().lower()
             == 'a6190887335179604bebc5c526d1a5dff858f503886f7aaef9b2e9d78b071f59';
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Gifts: only an admin can send one; the player it's for reads it, applies it and deletes it
    match /gifts/{uid}/items/{id} {
      allow read, delete: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['kind', 'id', 'n', 'msg', 't', 'by'])
        && request.resource.data.kind in ['notes', 'skin', 'banner', 'tiles', 'passp', 'rank', 'msg']
        && request.resource.data.by == request.auth.uid
        && request.resource.data.t is int
        && (!('id' in request.resource.data) || (request.resource.data.id is string && request.resource.data.id.size() <= 40))
        && (!('n' in request.resource.data) || (request.resource.data.n is number && request.resource.data.n >= -1 && request.resource.data.n <= 1000000))
        && (!('msg' in request.resource.data) || (request.resource.data.msg is string && request.resource.data.msg.size() <= 120));
      allow update: if false;
    }

    // Receipts for website purchases. Only the payment server (app/api/worker.js, as a Google service account, which
    // these rules don't apply to) writes them after Stripe confirms the payment; a player can read their own.
    match /purchases/{uid}/items/{id} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // The live event: one site-wide event everyone can see (even signed out); only an admin starts, changes or ends it
    match /live/{doc} {
      allow read: if true;
      allow create, update: if isAdmin() && doc == 'event'
        && request.resource.data.keys().hasOnly(['id', 'title', 'msg', 'xp', 'notes', 'start', 'end', 'gift', 'by', 't', 'mode'])
        && (!('mode' in request.resource.data) || request.resource.data.mode in ['erlaf'])
        && request.resource.data.id is string && request.resource.data.id.size() <= 32
        && request.resource.data.title is string && request.resource.data.title.size() <= 40
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 140
        && request.resource.data.xp is number && request.resource.data.xp >= 1 && request.resource.data.xp <= 3
        && request.resource.data.notes is number && request.resource.data.notes >= 1 && request.resource.data.notes <= 3
        && request.resource.data.start is int && request.resource.data.end is int
        && request.resource.data.end >= request.resource.data.start
        && request.resource.data.by == request.auth.uid
        && (request.resource.data.gift == null
            || (request.resource.data.gift is map && request.resource.data.gift.keys().hasOnly(['kind', 'id', 'n'])
                && request.resource.data.gift.kind in ['notes', 'skin', 'banner', 'tiles']));
      allow delete: if isAdmin();
    }

    match /users/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      // one save per account: only the save itself, its time and the account's display name, and no giant documents
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['save', 't', 'name'])
        && request.resource.data.save is string && request.resource.data.save.size() < 900000
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 120));
    }
    // Leaderboards: anyone can view; players can only write their own entry.
    //  - A score can only go up, stays under a believable ceiling (the Ascent board packs floor x 1,000,000 + points), and
    //    each new score is stamped with the server's clock (t = request.time), at least 5 seconds after the last one.
    //  - An update that keeps the same score (a rename, a new block or banner) can't touch the time.
    //  - Ranks are 0-26, names, blocks, banners and titles are short.
    function boardMax(board) {
      return board == 'ascent' ? 2000000000 : 20000000;
    }
    function boardEntryOk(board) {
      return request.resource.data.keys().hasOnly(['name', 'rank', 'score', 'skin', 't', 'banner', 'title'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 32
        && request.resource.data.rank is int && request.resource.data.rank >= 0 && request.resource.data.rank <= 26
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= boardMax(board)
        && request.resource.data.skin is string && request.resource.data.skin.size() <= 64
        && (!('banner' in request.resource.data) || (request.resource.data.banner is string && request.resource.data.banner.size() <= 24))
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 40));
    }
    match /boards/{board}/entries/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid && board.size() <= 64 && boardEntryOk(board)
        && request.resource.data.t == request.time;
      allow update: if signedIn() && request.auth.uid == uid && boardEntryOk(board)
        && request.resource.data.score >= resource.data.score
        && (
          // a rename or a new look: same score, same time
          (request.resource.data.score == resource.data.score && request.resource.data.t == resource.data.t)
          // a new best: stamped now, and not within 5 seconds of the last one (older entries have a number for t)
          || (request.resource.data.score > resource.data.score && request.resource.data.t == request.time
              && (!(resource.data.t is timestamp) || request.time > resource.data.t + duration.value(5, 's')))
        );
      // a player deleting their account removes their own scores
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Friends: public player cards (name, rank, block, progress, bests, built levels, last seen). Only you write yours;
    // the name is short, the rank is a real rank (0-26), and the built-level list is capped
    match /profiles/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && (!('nameKey' in request.resource.data) || (request.resource.data.nameKey is string && request.resource.data.nameKey.size() <= 24))
        && (!('rank' in request.resource.data) || (request.resource.data.rank is int && request.resource.data.rank >= 0 && request.resource.data.rank <= 26))
        && (!('code' in request.resource.data) || request.resource.data.code == null || (request.resource.data.code is string && request.resource.data.code.size() == 6))
        && (!('levels' in request.resource.data) || (request.resource.data.levels is list && request.resource.data.levels.size() <= 24))
        && request.resource.data.keys().size() <= 40;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Friend codes: anyone signed in can look one up; a code can be claimed once and never changed
    match /codes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && code.size() == 6;
      allow update: if false;
      // only when its owner deletes their account
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Friends lists: only you can see yours. Friendship is two-way, so when you add someone's code
    // you may also add yourself to their list (only if they are already on yours), or take yourself off it.
    match /friends/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uids is list && request.resource.data.uids.size() <= 50;
      // someone else adding themselves
      allow create: if signedIn() && request.auth.uid != uid
        && request.resource.data.keys().hasOnly(['uids'])
        && request.resource.data.uids == [request.auth.uid]
        && uid in get(/databases/$(db)/documents/friends/$(request.auth.uid)).data.uids;
      allow update: if signedIn() && request.auth.uid != uid
        && request.resource.data.keys().hasOnly(['uids'])
        && request.resource.data.uids is list && request.resource.data.uids.size() <= 50
        && (
          (request.resource.data.uids.toSet() == resource.data.uids.toSet().union([request.auth.uid].toSet())
            && uid in get(/databases/$(db)/documents/friends/$(request.auth.uid)).data.uids)
          || request.resource.data.uids.toSet() == resource.data.uids.toSet().difference([request.auth.uid].toSet())
        );
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ---- Cale vs Korra: 9:00 AM Central Wed Sep 30 2026 to 9:00 AM Central Sat Oct 3 2026 ----
    // Signing up: the code must match that side's fingerprint (SHA-256), and each side can be claimed once.
    // Only the person who signed up can read their claim (it holds their code).
    match /events/cvk/claims/{side} {
      allow get: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && (side == 'cale' || side == 'korra')
        && request.resource.data.keys().hasOnly(['uid','code','t'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.code is string
        && hashing.sha256(request.resource.data.code).toHexString().lower()
             == (side == 'cale' ? 'bf9254eff060b724af4f9ff4562baff0ea6e8650ebe2b2d4fa7f51ffe832c5b7' : 'cdf74e040ee0af0702471fbb74f8bafecee16afcc43bb9f7b726263044bc99fe')
        && request.time < timestamp.value(1791036000000);
      allow update, delete: if false;
    }
    // The bars: everyone can watch; only the side's player can add to it, only while the event is live,
    // and at most 400,000 points at a time. The bar also shows the player's current username.
    match /events/cvk/sides/{side} {
      allow read: if true;
      allow create: if signedIn()
        && get(/databases/$(db)/documents/events/cvk/claims/$(side)).data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['score','t','name'])
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 24))
        && request.resource.data.score == 0;
      allow update: if signedIn()
        && get(/databases/$(db)/documents/events/cvk/claims/$(side)).data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['score','t','name'])
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 24))
        && request.resource.data.score is number
        && request.resource.data.score >= resource.data.score
        && request.resource.data.score - resource.data.score <= 400000
        // the score only moves while the event is live; the player's username can be updated any time
        && (request.resource.data.score == resource.data.score
            || (request.time >= timestamp.value(1790776800000) && request.time < timestamp.value(1791036000000)));
      allow delete: if false;
    }

    // Betting on Cale vs Korra: everyone can see the bets; you can only add to your own, at most 100,000 notes
    // at a time, until 9:00 AM Central Thu Oct 1 2026 (a day into the event). Amounts never go down.
    match /events/cvk/bets/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['cale','korra','name','t'])
        && request.resource.data.cale is number && request.resource.data.korra is number
        && request.resource.data.cale >= 0 && request.resource.data.korra >= 0
        && request.resource.data.cale + request.resource.data.korra <= 100000
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.time < timestamp.value(1790863200000);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['cale','korra','name','t'])
        && request.resource.data.cale is number && request.resource.data.korra is number
        && request.resource.data.cale >= resource.data.cale && request.resource.data.korra >= resource.data.korra
        && (request.resource.data.cale - resource.data.cale) + (request.resource.data.korra - resource.data.korra) <= 100000
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.time < timestamp.value(1790863200000);
      allow delete: if false;
    }

    // Party invites: only someone on the recipient's friends list can invite them
    match /invites/{to}/items/{from} {
      allow create, update: if signedIn() && request.auth.uid == from
        && exists(/databases/$(db)/documents/friends/$(to))
        && from in get(/databases/$(db)/documents/friends/$(to)).data.uids
        && request.resource.data.code is string && request.resource.data.code.size() == 4;
      allow read: if signedIn() && request.auth.uid == to;
      allow delete: if signedIn() && (request.auth.uid == to || request.auth.uid == from);
    }

    // Gifting a block to a friend: only someone on the recipient's friends list can send one, and only one a day
    // (the id is "<sender>_<day>", and a gift can't be changed once sent). Only the recipient can read and clear them.
    match /fgifts/{to}/items/{id} {
      allow create: if signedIn() && request.auth.uid != to
        && request.resource.data.keys().hasOnly(['from', 'name', 'skin', 't', 'day'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.day is string && request.resource.data.day.size() <= 12
        && id == request.auth.uid + '_' + request.resource.data.day
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.skin is string && request.resource.data.skin.size() > 0 && request.resource.data.skin.size() <= 40
        && request.resource.data.t is int
        && exists(/databases/$(db)/documents/friends/$(to))
        && request.auth.uid in get(/databases/$(db)/documents/friends/$(to)).data.uids;
      allow update: if false;
      allow read, delete: if signedIn() && request.auth.uid == to;
    }

    // Trading blocks between friends. An offer is trades/{to}/items/{from}: one open offer from one friend to another.
    // The sender can withdraw it; the recipient can only remove it while answering it (the same batched write must
    // create the answer below), so an offer is never silently lost.
    match /trades/{to}/items/{from} {
      allow create: if signedIn() && request.auth.uid == from && from != to
        && request.resource.data.keys().hasOnly(['from', 'name', 'give', 'want', 't'])
        && request.resource.data.from == from
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.give is string && request.resource.data.give.size() > 0 && request.resource.data.give.size() <= 40
        && request.resource.data.want is string && request.resource.data.want.size() > 0 && request.resource.data.want.size() <= 40
        && request.resource.data.give != request.resource.data.want
        && request.resource.data.t is int
        && exists(/databases/$(db)/documents/friends/$(to))
        && from in get(/databases/$(db)/documents/friends/$(to)).data.uids;
      allow update: if false;
      allow read: if signedIn() && (request.auth.uid == to || request.auth.uid == from);
      // (withdrawing needs the offer to still be there: once it's answered, the answer decides)
      allow delete: if signedIn() && ((request.auth.uid == from && resource.data.from == request.auth.uid)
        || (request.auth.uid == to && existsAfter(/databases/$(db)/documents/tradeReplies/$(from)/items/$(to))));
    }

    // The answer to a trade offer: tradeReplies/{offerer}/items/{answerer}. It can only be written together with removing
    // the offer it answers, and must match that offer exactly (the same time, and the two blocks swapped).
    match /tradeReplies/{to}/items/{from} {
      allow create: if signedIn() && request.auth.uid == from
        && request.resource.data.keys().hasOnly(['from', 'ok', 'give', 'got', 'offerT', 't'])
        && request.resource.data.from == from
        && request.resource.data.ok is bool
        && request.resource.data.offerT is int && request.resource.data.t is int
        && exists(/databases/$(db)/documents/trades/$(from)/items/$(to))
        && !existsAfter(/databases/$(db)/documents/trades/$(from)/items/$(to))
        && get(/databases/$(db)/documents/trades/$(from)/items/$(to)).data.t == request.resource.data.offerT
        && get(/databases/$(db)/documents/trades/$(from)/items/$(to)).data.give == request.resource.data.got
        && get(/databases/$(db)/documents/trades/$(from)/items/$(to)).data.want == request.resource.data.give;
      allow update: if false;
      allow read, delete: if signedIn() && request.auth.uid == to;
    }

    // Featured levels: anyone can read them; only an admin can feature or remove one.
    match /featured/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Sending a level in to be featured: one at a time per player (their own document). Only admins (and the sender) can read it.
    match /featReq/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['by', 'n', 'code', 'likes', 'key', 't'])
        && request.resource.data.by is string && request.resource.data.by.size() <= 24
        && request.resource.data.n is string && request.resource.data.n.size() <= 40
        && request.resource.data.code is string && request.resource.data.code.size() > 0 && request.resource.data.code.size() <= 20000
        && request.resource.data.likes is int && request.resource.data.likes >= 0 && request.resource.data.likes <= 100000
        && request.resource.data.key is string && request.resource.data.key.size() <= 16
        && request.resource.data.t is int;
      allow read, delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // Likes on built levels: one per player per level (the id is "<liker>_<level key>"), never on your own.
    // The builder can list them to count their likes; a player can only see, add or take back their own.
    match /likes/{owner}/items/{id} {
      allow create: if signedIn() && request.auth.uid != owner
        && request.resource.data.keys().hasOnly(['by', 'key', 't'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.key is string && request.resource.data.key.size() > 0 && request.resource.data.key.size() <= 16
        && id == request.auth.uid + '_' + request.resource.data.key
        && request.resource.data.t is int;
      allow update: if false;
      allow get: if signedIn() && (request.auth.uid == owner || id.matches(request.auth.uid + '_.+'));
      allow list: if signedIn() && request.auth.uid == owner;
      allow delete: if signedIn() && (request.auth.uid == owner || id.matches(request.auth.uid + '_.+'));
    }

    /*
     * TWIN PULSE: the 2v2 bracket, Mon Oct 5 – Fri Oct 9, 2026 (all times Central)
     *   events/twin/teams/{teamId}   = {name, nameKey, code, members:[uid,uid], names:[..], owner, created}
     *   events/twin/codes/{code}     = {teamId}     a team's join code, claimed once
     *   events/twin/names/{nameKey}  = {teamId}     a team name, claimed once (case-insensitive)
     *   events/twin/players/{uid}    = {teamId}     one team per player
     *   events/twin/rounds/{r}/scores/{teamId} = {score, t, by}   the team's best run in round r
     * Teams form, change and break up only while sign-ups are open (Mon 12:00 AM – 3:30 PM). Every change is one
     * transaction, and each document checks the others as they will be after it (getAfter/existsAfter).
     */
    function twOpen() {
      return request.time >= timestamp.value(1791176400000) && request.time < timestamp.value(1791232200000);
    }
    function twTeamPath(t) { return /databases/$(db)/documents/events/twin/teams/$(t); }
    function twPlayerPath(u) { return /databases/$(db)/documents/events/twin/players/$(u); }
    function twNameOk(d) {
      return d.name is string && d.name.size() >= 2 && d.name.size() <= 20
        && d.nameKey is string && d.nameKey.matches('^[a-z0-9]{2,20}$');
    }
    function twShape(d) {
      return d.keys().hasOnly(['name', 'nameKey', 'code', 'members', 'names', 'owner', 'created'])
        && d.members is list && d.names is list && d.names.size() == d.members.size() && d.members.size() <= 2
        && d.code is string && d.code.matches('^[A-Z0-9]{5}$') && d.created is int && twNameOk(d);
    }

    match /events/twin/teams/{tid} {
      allow read: if true;
      allow create: if signedIn() && twOpen() && tid.matches('^[a-z0-9]{8,16}$')
        && twShape(request.resource.data)
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.owner == request.auth.uid
        && getAfter(/databases/$(db)/documents/events/twin/codes/$(request.resource.data.code)).data.teamId == tid
        && getAfter(/databases/$(db)/documents/events/twin/names/$(request.resource.data.nameKey)).data.teamId == tid
        && getAfter(twPlayerPath(request.auth.uid)).data.teamId == tid;
      allow update: if signedIn() && twOpen() && twShape(request.resource.data)
        && request.resource.data.code == resource.data.code
        && request.resource.data.created == resource.data.created
        && (
          // a second player joins
          (resource.data.members.size() == 1
            && !resource.data.members.hasAny([request.auth.uid])
            && request.resource.data.members == resource.data.members.concat([request.auth.uid])
            && request.resource.data.name == resource.data.name
            && request.resource.data.nameKey == resource.data.nameKey
            && request.resource.data.owner == resource.data.owner
            && getAfter(twPlayerPath(request.auth.uid)).data.teamId == tid)
          // one of two leaves; the one who stays runs the team
          || (resource.data.members.size() == 2
            && resource.data.members.hasAny([request.auth.uid])
            && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
            && request.resource.data.owner == request.resource.data.members[0]
            && request.resource.data.name == resource.data.name
            && request.resource.data.nameKey == resource.data.nameKey
            && !existsAfter(twPlayerPath(request.auth.uid)))
          // the team's owner renames it
          || (resource.data.owner == request.auth.uid
            && request.resource.data.members == resource.data.members
            && request.resource.data.names == resource.data.names
            && request.resource.data.owner == resource.data.owner
            && getAfter(/databases/$(db)/documents/events/twin/names/$(request.resource.data.nameKey)).data.teamId == tid)
        );
      // the last player leaving closes the team
      allow delete: if signedIn() && twOpen()
        && resource.data.members == [request.auth.uid]
        && !existsAfter(twPlayerPath(request.auth.uid));
    }
    match /events/twin/codes/{code} {
      allow read: if true;
      allow create: if signedIn() && twOpen() && request.resource.data.keys().hasOnly(['teamId'])
        && getAfter(twTeamPath(request.resource.data.teamId)).data.code == code
        && getAfter(twTeamPath(request.resource.data.teamId)).data.owner == request.auth.uid;
      allow delete: if signedIn() && twOpen()
        && get(twTeamPath(resource.data.teamId)).data.members.hasAny([request.auth.uid])
        && !existsAfter(twTeamPath(resource.data.teamId));
    }
    match /events/twin/names/{key} {
      allow read: if true;
      allow create: if signedIn() && twOpen() && request.resource.data.keys().hasOnly(['teamId'])
        && getAfter(twTeamPath(request.resource.data.teamId)).data.nameKey == key
        && getAfter(twTeamPath(request.resource.data.teamId)).data.owner == request.auth.uid;
      allow delete: if signedIn() && twOpen()
        && get(twTeamPath(resource.data.teamId)).data.members.hasAny([request.auth.uid])
        && (!existsAfter(twTeamPath(resource.data.teamId))
            || getAfter(twTeamPath(resource.data.teamId)).data.nameKey != key);
    }
    match /events/twin/players/{uid} {
      allow read: if true;
      allow create: if signedIn() && twOpen() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['teamId'])
        && getAfter(twTeamPath(request.resource.data.teamId)).data.members.hasAny([uid]);
      allow delete: if signedIn() && twOpen() && request.auth.uid == uid
        && (!existsAfter(twTeamPath(resource.data.teamId))
            || !getAfter(twTeamPath(resource.data.teamId)).data.members.hasAny([uid]));
    }
    // a team's best run in round r (1-4): only its own players, only while that round runs, only upward
    match /events/twin/rounds/{r}/scores/{tid} {
      allow read: if true;
      allow create, update: if signedIn() && r in ['1', '2', '3', '4']
        && request.time >= timestamp.value(1791232200000 + (int(r) - 1) * 86400000)
        && request.time < timestamp.value(1791232200000 + int(r) * 86400000)
        && get(twTeamPath(tid)).data.members.hasAny([request.auth.uid])
        && get(twTeamPath(tid)).data.members.size() == 2
        && request.resource.data.keys().hasOnly(['score', 't', 'by'])
        && request.resource.data.score is int && request.resource.data.score > 0 && request.resource.data.score <= 2000000
        && request.resource.data.t is int && request.resource.data.by == request.auth.uid
        && (resource == null || request.resource.data.score > resource.data.score);
      allow delete: if false;
    }

    // Reports of other players (offensive names or levels, cheating, harassment). Anyone signed in can file one;
    // nobody can read, change or delete them from the game: review them in the Firebase console.
    match /reports/{id} {
      // one report per player per reporter (the document id is "<reporter>_<reported>"), so reports can't be piled up
      allow create: if signedIn()
        && id == request.auth.uid + '_' + request.resource.data.uid
        && request.resource.data.keys().hasOnly(['by', 'uid', 'name', 'why', 'where', 't'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.uid is string && request.resource.data.uid.size() > 0 && request.resource.data.uid.size() <= 128
        && request.resource.data.uid != request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.why in ['name', 'cheat', 'levels', 'abuse', 'other']
        && request.resource.data.where is string && request.resource.data.where.size() <= 20
        && request.resource.data.t is int;
      allow read, update, delete: if isAdmin();
    }


    // ================= CLASSROOMS =================
    // Teachers (real accounts) make classes; students join with the class code and a display name (guests allowed).
    // A student's work is visible only to that student and their teacher.
    function cls(cid) { return get(/databases/$(db)/documents/classes/$(cid)).data; }
    function teaches(cid) { return signedIn() && cls(cid).teacher == request.auth.uid; }
    function inClass(cid) { return authed() && exists(/databases/$(db)/documents/classes/$(cid)/students/$(request.auth.uid)); }
    function shortStr(v, n) { return v is string && v.size() <= n; }

    // verified teachers can share question packs publicly; only an admin can verify
    match /teachers/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
    match /classes/{cid} {
      allow read: if (signedIn() && resource.data.teacher == request.auth.uid) || inClass(cid) || isAdmin();
      allow create: if signedIn() && request.resource.data.teacher == request.auth.uid
        && request.resource.data.keys().hasOnly(['teacher', 'tname', 'name', 'grade', 'code', 'locked', 'kicked', 'exp', 't'])
        && shortStr(request.resource.data.name, 40) && request.resource.data.name.size() > 0
        && shortStr(request.resource.data.tname, 40) && shortStr(request.resource.data.grade, 12)
        && shortStr(request.resource.data.code, 6) && request.resource.data.locked is bool
        && request.resource.data.kicked is list && request.resource.data.kicked.size() == 0
        && request.resource.data.exp is int && request.resource.data.t is int;
      allow update: if signedIn() && resource.data.teacher == request.auth.uid
        && request.resource.data.teacher == resource.data.teacher
        && request.resource.data.keys().hasOnly(['teacher', 'tname', 'name', 'grade', 'code', 'locked', 'kicked', 'exp', 't'])
        && shortStr(request.resource.data.name, 40) && shortStr(request.resource.data.code, 6)
        && request.resource.data.locked is bool && request.resource.data.kicked is list && request.resource.data.kicked.size() <= 500;
      allow delete: if signedIn() && resource.data.teacher == request.auth.uid;

      // students: you add yourself (if the class is open and you weren't removed); the teacher can rename or remove you
      match /students/{uid} {
        allow read: if (authed() && request.auth.uid == uid) || teaches(cid);
        allow create: if authed() && request.auth.uid == uid
          && cls(cid).locked == false && !(uid in cls(cid).kicked) && request.time.toMillis() < cls(cid).exp
          && request.resource.data.keys().hasOnly(['name', 't'])
          && shortStr(request.resource.data.name, 24) && request.resource.data.name.size() > 0 && request.resource.data.t == request.time;
        allow update: if ((authed() && request.auth.uid == uid) || teaches(cid))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && shortStr(request.resource.data.name, 24) && request.resource.data.name.size() > 0;
        allow delete: if (authed() && request.auth.uid == uid) || teaches(cid);
      }
      // homework: the teacher writes it, the class reads it
      match /assign/{aid} {
        allow read: if teaches(cid) || inClass(cid);
        allow create, update: if teaches(cid)
          && request.resource.data.keys().hasOnly(['title', 'levels', 'pack', 'packName', 'qs', 'due', 'diff', 'shuffle', 't'])
          && shortStr(request.resource.data.title, 40) && request.resource.data.levels is list && request.resource.data.levels.size() <= 12
          && request.resource.data.qs is list && request.resource.data.qs.size() <= 100
          && request.resource.data.diff in ['easy', 'normal'];
        allow delete: if teaches(cid);
        // each student's own progress on it
        match /work/{uid} {
          allow read: if (authed() && request.auth.uid == uid) || teaches(cid);
          allow create, update: if authed() && request.auth.uid == uid && inClass(cid)
            && request.resource.data.keys().hasOnly(['name', 'lv', 'right', 'asked', 'done', 'time', 'late', 't'])
            && shortStr(request.resource.data.name, 24) && request.resource.data.lv is map && request.resource.data.lv.size() <= 12
            && request.resource.data.right is number && request.resource.data.asked is int && request.resource.data.asked <= 24
            && request.resource.data.right <= request.resource.data.asked && request.resource.data.done is int && request.resource.data.done <= 12
            && request.resource.data.t == request.time;
          allow delete: if teaches(cid);
        }
      }
      // saved results of live games hosted for this class
      match /games/{gid} {
        allow read, delete: if teaches(cid);
        allow create: if teaches(cid) && request.resource.data.players is list && request.resource.data.players.size() <= 200;
      }
    }
    // class codes: look one up to join; claimed once by the class's teacher
    match /classCodes/{code} {
      allow get: if authed();
      allow create: if signedIn() && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.keys().hasOnly(['cid', 'teacher']) && request.resource.data.teacher == request.auth.uid
        && cls(request.resource.data.cid).teacher == request.auth.uid;
      allow delete: if signedIn() && resource.data.teacher == request.auth.uid;
    }
    // question packs: every new or changed pack waits for an admin to approve it (status 'pending' → 'approved' or
    // 'rejected' with a note); the maker can't approve their own. A public pack is visible to other teachers only once
    // approved. Anyone signed in can report a public pack, which hides it until an admin looks at it.
    function packOk() {
      return request.resource.data.keys().hasOnly(['owner', 'oname', 'title', 'subject', 'grade', 'desc', 'vis', 'hidden', 'qs', 'n', 'status', 'note', 't'])
        && request.resource.data.status == 'pending' && request.resource.data.note == ''
        && request.resource.data.owner == request.auth.uid
        && shortStr(request.resource.data.title, 60) && request.resource.data.title.size() > 0
        && shortStr(request.resource.data.oname, 24) && shortStr(request.resource.data.subject, 24)
        && shortStr(request.resource.data.grade, 12) && shortStr(request.resource.data.desc, 160)
        && request.resource.data.vis in ['private', 'public'] && request.resource.data.hidden is bool
        && request.resource.data.qs is list && request.resource.data.qs.size() <= 100;
    }
    match /packs/{pid} {
      allow read: if (signedIn() && resource.data.owner == request.auth.uid)
        || (signedIn() && resource.data.vis == 'public' && resource.data.status == 'approved' && resource.data.hidden == false) || isAdmin();
      // review links: anyone with the link can open an approved pack (no sign-in), but can't list or search packs
      allow get: if resource.data.status == 'approved' && resource.data.hidden == false;
      allow create: if signedIn() && packOk() && request.resource.data.hidden == false;
      allow update: if (signedIn() && resource.data.owner == request.auth.uid && packOk() && request.resource.data.hidden == resource.data.hidden)
        || (signedIn() && resource.data.vis == 'public' && resource.data.status == 'approved' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden']) && request.resource.data.hidden == true)
        || isAdmin();
      allow delete: if (signedIn() && resource.data.owner == request.auth.uid) || isAdmin();
    }
    // live class games: the host (a real account) runs the game; each player writes only their own score,
    // at most about once a second, and scores can only go up a little at a time
    match /live/{pin} {
      allow read: if authed();
      allow create: if signedIn() && pin.matches('^[0-9]{6}$') && request.resource.data.host == request.auth.uid
        && request.resource.data.mode in ['race', 'tower', 'jam', 'last'] && request.resource.data.diff in ['easy', 'normal']
        && request.resource.data.qs is list && request.resource.data.qs.size() <= 100 && request.resource.data.kicked is list;
      allow update: if signedIn() && resource.data.host == request.auth.uid && request.resource.data.host == resource.data.host
        && request.resource.data.qs is list && request.resource.data.qs.size() <= 100
        && (!('kicked' in request.resource.data) || request.resource.data.kicked.size() <= 300);
      allow delete: if signedIn() && resource.data.host == request.auth.uid;
      match /players/{uid} {
        allow read: if authed();
        allow create: if authed() && request.auth.uid == uid
          && get(/databases/$(db)/documents/live/$(pin)).data.phase != 'end'
          && !(uid in get(/databases/$(db)/documents/live/$(pin)).data.kicked)
          && request.resource.data.keys().hasOnly(['name', 'skin', 'banner', 'score', 'right', 'done', 'fl', 'rev', 'team', 'hearts', 'ans', 'fin', 't'])
          && shortStr(request.resource.data.name, 24) && request.resource.data.name.size() > 0
          && (!('skin' in request.resource.data) || shortStr(request.resource.data.skin, 40))
          && (!('banner' in request.resource.data) || shortStr(request.resource.data.banner, 24))
          && request.resource.data.score == 0 && request.resource.data.done == 0 && request.resource.data.t == request.time;
        allow update: if (authed() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score', 'right', 'done', 'fl', 'rev', 'hearts', 'ans', 'fin', 't'])
            && request.resource.data.t == request.time && request.time > resource.data.t + duration.value(900, 'ms')
            && request.resource.data.score >= resource.data.score && request.resource.data.score <= resource.data.score + 1000
            && request.resource.data.done <= resource.data.done + 1 && request.resource.data.right <= request.resource.data.done
            && request.resource.data.fl <= resource.data.fl + 2 && request.resource.data.rev <= resource.data.rev + 1
            && request.resource.data.hearts is int && request.resource.data.hearts >= 0 && request.resource.data.hearts <= 3
            && request.resource.data.ans is map && request.resource.data.ans.size() <= 100)
          || (signedIn() && get(/databases/$(db)/documents/live/$(pin)).data.host == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['team', 'hearts']));
        allow delete: if (authed() && request.auth.uid == uid) || (signedIn() && get(/databases/$(db)/documents/live/$(pin)).data.host == request.auth.uid);
      }
    }

  }
}
